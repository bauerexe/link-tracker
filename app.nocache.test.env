bot{
    app_telegram_token = "dummy"
    app_telegram_token = ${?APP_TELEGRAM_TOKEN}

    scrapper_addr_grpc = "scrapper:50051"
    bot_addr_grpc = "0.0.0.0:50052"
    bot_addr_http = "0.0.0.0:8082"
    bot_disable_telegram = true
}

scrapper{
    scrapper_addr_grpc = "0.0.0.0:50051"
    scrapper_addr_http = "0.0.0.0:8080"
    bot_addr_grpc = "bot:50052"
    github_token = "dummy"
    stack_overflow_key = "dummy"
    seconds_interval_check = 30
    postgres_dsn="postgres://postgres:postgres@postgres:5432/link_tracker?sslmode=disable"
    migrations_path ="/app/migrations"
    db_access_type="orm"
    batch_size = 100
    worker_count = 4
    valkey_addr = ""
    valkey_password = ""
    valkey_db = 0
    cache_enabled = false
    cache_ttl = "5m"
}

kafka{
    kafka_enabled="true"
    kafka_topic="notifiers"
    kafka_consumer_group="notifiers-consumer"
    kafka_brokers = ["kafka-1:19092","kafka-2:19092","kafka-3:19092"]
    max_retries=3
    dlq_topic="dead-letter-topic"
    schema_subject="update_link_request"
    schema_registry_url="http://schema-registry:8081"
}
